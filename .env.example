# ARVIS environment.
#   VPS (brain):      copy to /opt/arvis/.env (owner arvis, chmod 600). Hermes reads ~/.hermes/.env
#                     for LLM/Telegram keys; the rest is read by the skills.
#   GitHub Actions:   add SUPABASE_URL, SUPABASE_SERVICE_KEY, BRAVE_SEARCH_API_KEY, HUNTER_API_KEY
#                     as repository secrets (Settings -> Secrets and variables -> Actions).
#   Vercel:           add NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY.
# Never commit the real file. Everything below has a free tier unless noted.

# --- Telegram control panel ---------------------------------------------------
# @BotFather on Telegram -> /newbot -> name "ARVIS" -> copy the token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (send /start to @userinfobot). Only this id may command ARVIS.
TELEGRAM_ALLOWED_USERS=

# --- LLMs: the brain talks to arvis-router (brain/router/router.py, 127.0.0.1:8090) which fails
#     over across the FREE providers below in ROUTER_ORDER. Add any key, restart the router.
ROUTER_ORDER=gemini-lite,gemini,cerebras,nvidia,groq,openrouter-free
# NVIDIA free endpoint (generous limits): https://build.nvidia.com -> any model -> Get API key
NVIDIA_API_KEY=
# --- LLMs (main + fallbacks) ---------------------------------------------------
# Gemini free tier: https://aistudio.google.com/apikey  (Hermes reads GOOGLE_API_KEY)
GOOGLE_API_KEY=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras free tier: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# OpenRouter (":free" models, optionally ~$10/mo paid model): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# NOTE: free tiers rate-limit a 24/7 agent. Hermes falls back in the order above.

# --- Search / lookup -----------------------------------------------------------
# Public web search for enrichment: Google Programmable Search, 100 queries/day FREE, no card.
#   programmablesearchengine.google.com -> Add -> "Search the entire web" -> copy the Search engine ID (cx)
#   console.cloud.google.com (project arvis-514813) -> APIs -> enable "Custom Search API" -> Credentials -> API key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Brave Search API (optional; its free plan asks for a card, so skipped)
BRAVE_SEARCH_API_KEY=
# Hunter.io free tier (25 searches + 50 verifications/mo): https://hunter.io/api-keys
HUNTER_API_KEY=
# Self-hosted Reacher email verifier (docker). No key; local URL.
REACHER_URL=http://127.0.0.1:8081
# GitHub: fine-grained token with "Actions: read/write" on itsmearyanabc/Arvis so the brain
# can dispatch and watch worker runs: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPO=itsmearyanabc/Arvis

# --- Google Sheets mirror (optional, Aryan likes browsing leads in Sheets) ------------
# Google Cloud console -> new project -> APIs -> enable "Google Sheets API" -> IAM -> Service
# accounts -> create -> Keys -> add JSON key. Share the Sheet with the service-account email
# (Editor). In GitHub Actions store the JSON *contents* as the secret GOOGLE_SERVICE_ACCOUNT_JSON.
# On the VPS: scp the JSON to /opt/arvis/secrets/google-service-account.json (owner arvis, chmod 600)
# and put both lines below in /opt/arvis/.env so `arvisctl sheets` / `arvisctl mirror` work.
GOOGLE_SERVICE_ACCOUNT_JSON=/opt/arvis/secrets/google-service-account.json
GOOGLE_SHEET_ID=
# Your Google account email: new per-task sheets created by ARVIS are shared with it
ARVIS_OWNER_EMAIL=

# --- Supabase: system of record (ARVIS's OWN project, region Mumbai, never armedias.com's) --
# https://supabase.com -> New project "arvis" -> Region: Mumbai (ap-south-1) -> Settings -> API
# Run supabase/schema.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # the "secret" key (sb_secret_...; legacy name service_role): brain + workers only, never in a browser
SUPABASE_ANON_KEY=             # the "publishable" key (sb_publishable_...; legacy name anon): dashboard (Vercel) with Aryan's login

# --- Monitoring ----------------------------------------------------------------
# UptimeRobot free plan (off-box monitoring): https://uptimerobot.com -> Integrations & API -> Main API key
UPTIMEROBOT_API_KEY=

# --- Cold-email mailboxes (Zoho Mail on armedias.tech) -----------------------------
# Aryan connected the root domain in Zoho (connect@armedias.tech), 2026-11-15. SPF/DKIM/DMARC
# per docs/dns.md, warm-up 2–3 weeks, DMARC p=none first. NEVER armedias.com.
SEND_DOMAIN=armedias.tech
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993
# One block per mailbox; add MAILBOX_2_*, MAILBOX_3_* as you add seats.
MAILBOX_1_USER=connect@armedias.tech
MAILBOX_1_PASS=                 # Zoho APP password, not the account password
MAILBOX_1_FROM_NAME=Aryan from AR Medias
MAILBOX_1_DAILY_CAP=20

# --- Compliance ----------------------------------------------------------------
# Real postal address printed in every outbound email (CAN-SPAM / CASL).
POSTAL_ADDRESS=
# Global daily cap across all mailboxes. Start at 50; raise slowly.
DAILY_SEND_CAP=50
# Approval gate. "true" = nothing is sent unless approved_by_aryan is TRUE in Supabase.
REQUIRE_APPROVAL=true

# --- Cal.com (Phase 4, hosted free plan with custom domain) --------------------
CALCOM_URL=https://book.armedias.tech
CALCOM_API_KEY=
