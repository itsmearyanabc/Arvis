# ARVIS environment — copy to /opt/arvis/.env on the VPS (chmod 600, owner arvis).
# Never commit the real file. Everything below has a free tier unless noted.

# --- Telegram control panel ---------------------------------------------------
# @BotFather on Telegram -> /newbot -> name "ARVIS" -> copy the token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (send /start to @userinfobot). Only this id may command ARVIS.
TELEGRAM_ALLOWED_USERS=

# --- LLMs (main + fallbacks) ---------------------------------------------------
# Gemini free tier: https://aistudio.google.com/apikey  (Hermes reads GOOGLE_API_KEY)
GOOGLE_API_KEY=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras free tier: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# OpenRouter (":free" models, optionally ~$10/mo paid model): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# NOTE: free tiers rate-limit a 24/7 agent. Hermes falls back in the order above.

# --- Search / lookup -----------------------------------------------------------
# Brave Search API free tier (2,000 queries/mo): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Self-hosted SearXNG (docker/docker-compose.yml). No key; local URL.
SEARXNG_URL=http://127.0.0.1:8080
# Hunter.io free tier (25 searches + 50 verifications/mo): https://hunter.io/api-keys
HUNTER_API_KEY=
# Self-hosted Reacher email verifier (docker). No key; local URL.
REACHER_URL=http://127.0.0.1:8081
# Self-hosted Google Maps scraper web UI/API (docker). No key; local URL.
SCRAPER_URL=http://127.0.0.1:8082

# --- Google Sheets (system of record) -----------------------------------------
# Google Cloud console -> new project -> enable Sheets API -> Service account -> JSON key.
# Share the ARVIS spreadsheet with the service-account email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=/opt/arvis/secrets/google-service-account.json
GOOGLE_SHEET_ID=

# --- Supabase (ARVIS's OWN project, not the armedias.com one) -----------------
# https://supabase.com -> new project "arvis" -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Monitoring ----------------------------------------------------------------
# UptimeRobot free plan (off-box monitoring): https://uptimerobot.com -> Integrations & API -> Main API key
UPTIMEROBOT_API_KEY=

# --- Cold-email mailboxes (Zoho Mail on a SUBDOMAIN of armedias.tech) -----------
# Decided 2026-11-15: sending domain is mail.armedias.tech (own SPF/DKIM/DMARC, so a
# complaint hurts the subdomain, not armedias.tech's root or armedias.com). NEVER armedias.com.
SEND_DOMAIN=mail.armedias.tech
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993
# One block per mailbox; add MAILBOX_2_*, MAILBOX_3_* as you add seats.
MAILBOX_1_USER=
MAILBOX_1_PASS=
MAILBOX_1_FROM_NAME=
MAILBOX_1_DAILY_CAP=20

# --- Compliance ----------------------------------------------------------------
# Real postal address printed in every outbound email (CAN-SPAM / CASL).
POSTAL_ADDRESS=
# Global daily cap across all mailboxes. Start at 50; raise slowly.
DAILY_SEND_CAP=50
# Approval gate. "true" = nothing is sent unless approved_by_aryan is TRUE in the Sheet.
REQUIRE_APPROVAL=true

# --- Cal.com (Phase 4, hosted free plan with custom domain) --------------------
CALCOM_URL=https://book.armedias.tech
CALCOM_API_KEY=
