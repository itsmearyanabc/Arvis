# ARVIS dashboard (Vercel). Copy to .env.local for local dev. Never commit .env.local.
# Supabase -> Settings -> API of ARVIS's OWN project (Mumbai).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# "publishable" key (sb_publishable_...; legacy name anon). Safe in the browser; RLS gates it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "secret" key (sb_secret_...; legacy name service_role). Server-side API routes only.
SUPABASE_SERVICE_KEY=
# Random string; signs unsubscribe tokens (openssl rand -hex 24). Same value in the brain's env later.
UNSUBSCRIBE_SECRET=
# Optional: Cal.com webhook signing secret (Cal.com -> Settings -> Developer -> Webhooks).
CALCOM_WEBHOOK_SECRET=
# Optional: public URL of this dashboard, used in unsubscribe links.
NEXT_PUBLIC_SITE_URL=https://arvis.armedias.tech
